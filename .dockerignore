# The backend build context is deny-by-default. Keep this allowlist aligned
# with the explicit COPY instructions in Dockerfile.
**

!Dockerfile
!.dockerignore
!requirements.txt
!requirements.lock
!run.py
!alembic.ini

!app/
!app/**
!alembic/
!alembic/**
!scripts/
!scripts/*.py
!ui/
!ui/**

# Re-included source trees can contain local interpreter caches.
**/__pycache__/
**/*.py[cod]
