{
  "name": "nexus-rag-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:real": "vite --mode real",
    "build": "npm run build:real",
    "build:mock": "vite build --mode mock",
    "build:real": "node scripts/build-real.mjs",
    "audit:real": "node scripts/audit-real-build.mjs",
    "analyze:bundle": "node scripts/analyze-build.mjs --mode real --enforce && node scripts/analyze-build.mjs --mode mock --enforce",
    "test:build": "node scripts/verify-build-determinism.mjs",
    "ci:build": "npm run test:build && npm run audit:real && npm run analyze:bundle",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "lint:colors": "node scripts/color-audit.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/verify-format-contract.mjs && prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "dompurify": "3.4.13",
    "echarts": "6.1.0",
    "gsap": "3.15.0",
    "lucide-vue-next": "1.0.0",
    "marked": "18.0.7",
    "pinia": "4.0.2",
    "reka-ui": "2.10.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
