# The production frontend needs only build inputs and the Nginx config.
# In particular, no host dependencies, build/test output, or .env file is sent.
**

!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!nginx.conf.template

!public/
!public/**
!scripts/
!scripts/build-real.mjs
!scripts/audit-real-build.mjs
!src/
!src/**

# The container builds Real only; co-located tests and Mock-only modules are
# intentionally kept out of this production context.
**/*.spec.ts
**/*.test.ts
**/__snapshots__/
src/mocks/
src/mocks/**
src/api/loginModeMock.ts
src/api/adapters/mockRuntimeAdapter.ts
