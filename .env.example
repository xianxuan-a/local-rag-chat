# 应用
APP_NAME="Local RAG Chat"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_PREFIX="/api"
# 免认证本地开发只能监听明确的 loopback；局域网/容器监听必须同时启用认证。
HOST="127.0.0.1"
PORT=8000
# Compose 主机端口；正式 Vue 容器内监听 8080，legacy Streamlit 监听 8501。
BACKEND_PORT=8000
FRONTEND_PORT=8501
LEGACY_UI_PORT=8502
# CI/release 可设置为完整 40 位 commit SHA；本地默认保持 0.1.0。
IMAGE_TAG="0.1.0"
# Docker Real 构建的同源 API 超时；VITE_API_BASE_URL 固定为 /。
VITE_API_TIMEOUT_MS=15000
# Nginx 请求体上限需高于 MAX_UPLOAD_SIZE_MB，以容纳 multipart 元数据。
NGINX_CLIENT_MAX_BODY_SIZE="21m"
# 普通同源 API 的读取超时，应大于 CHAT_TIMEOUT_SECONDS。
NGINX_API_READ_TIMEOUT="75s"
# 可选：受限网络可覆盖为组织批准的 PyPI 镜像；默认使用官方源。
# PIP_INDEX_URL="https://pypi.org/simple"

# 日志与本地数据（相对路径从项目根目录解析）
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
CHROMA_DIR="data/chroma"
METADATA_DIR="data/metadata"
CHAT_HISTORY_DIR="data/chat_history"
BACKUP_DIR="data/backups"
EVALUATION_DIR="data/evaluations"
# 默认不覆盖 DATABASE_URL，由程序根据项目根目录生成。自定义示例：
# DATABASE_URL="sqlite:///./data/metadata/local_rag_chat.db"

# 文件入库与检索配置。修改向量空间字段后必须执行整库重建。
EMBEDDING_PROVIDER="dashscope"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZATION="l2"
EMBEDDING_PROTOCOL_VERSION="dashscope-text-embedding-v1"
VECTOR_DISTANCE_METRIC="cosine"
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=10
CHAT_MODEL="qwen3-max"
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_ATTEMPTS=2
RAG_CONTEXT_MAX_CHARS=12000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=
# 三种检索模式与联网策略。默认 Provider 为 disabled，不会访问外网。
WEB_SEARCH_ENABLED=false
DEFAULT_RETRIEVAL_MODE="knowledge_first"
RETRIEVAL_MIN_EVIDENCE_COUNT=1
RETRIEVAL_FRESHNESS_TERMS='["今天","当前","目前","最近","最新","现价","现任","刚刚","今年政策","today","current","recent","latest","now","this year"]'
WEB_SEARCH_PROVIDER="disabled"
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWED_ROLES='["ADMIN","USER"]'
WEB_SEARCH_ALLOWED_DOMAINS='[]'
WEB_SEARCH_BLOCKED_DOMAINS='[]'
WEB_SEARCH_RESULT_LIMIT=5
WEB_FETCH_MAX_PAGES=5
WEB_FETCH_MAX_PAGES_PER_DOMAIN=2
WEB_SEARCH_QUERY_MAX_CHARS=512
WEB_PAGE_MAX_CHARS=6000
WEB_FETCH_MAX_RESPONSE_BYTES=2097152
WEB_SEARCH_TIMEOUT_SECONDS=5
WEB_FETCH_TIMEOUT_SECONDS=5
WEB_TOTAL_TIMEOUT_SECONDS=12
WEB_FETCH_MAX_REDIRECTS=3
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_QUERY_LOG_MODE="digest"
WEB_CONTENT_CACHE_ENABLED=false
REBUILD_HTTP_TIMEOUT_SECONDS=3600

# 上传配置。列表必须使用 JSON 数组格式。
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS='[".txt", ".pdf", ".csv", ".json"]'

# 本地开发默认免认证且仅允许 loopback。生产/Compose 固定启用 AUTH_REQUIRED=true，不能覆盖为 false。
# 以下四项是生产必需且用途隔离的 Secret：至少 32 UTF-8 bytes、具备足够符号多样性，且彼此不得复用。
# 保持示例值为空；不要填写 changeme/default/重复字符等占位值，也不要提交真实值。
# 复制本文件后用 python scripts/init_secrets.py --env-file .env 独立安全生成。
JWT_SECRET=
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REQUIRED=false
ALLOW_REGISTRATION=true
# 认证敏感入口限流；生产环境不能关闭。官方 Compose 只信任 Docker DNS 中的 frontend 服务。
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_KEYS=10000
AUTH_RATE_LIMIT_TTL_SECONDS=3600
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_IP_ATTEMPTS=50
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_RATE_LIMIT_COMBINATION_ATTEMPTS=5
LOGIN_RATE_LIMIT_BACKOFF_BASE_SECONDS=2
LOGIN_RATE_LIMIT_BACKOFF_MAX_SECONDS=300
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_IP_ATTEMPTS=20
REGISTER_RATE_LIMIT_TARGET_ATTEMPTS=5
BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=3600
BOOTSTRAP_RATE_LIMIT_IP_ATTEMPTS=5
BOOTSTRAP_RATE_LIMIT_GLOBAL_ATTEMPTS=10
# 仅填写实际直连且受控的反向代理 IP/CIDR；为空时忽略所有 Forwarded/X-Forwarded-For。
TRUSTED_PROXY_CIDRS=[]
# Docker/Kubernetes 内可填写受控服务 DNS 名；解析结果短期缓存，普通公网部署优先使用 CIDR。
TRUSTED_PROXY_HOSTS=[]
METRICS_SCRAPE_TOKEN=
BACKUP_SIGNING_KEY=
BOOTSTRAP_SECRET=

# 单进程、单线程持久化 Job worker
JOB_POLL_INTERVAL_SECONDS=0.25
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=5
JOB_PROGRESS_MIN_INTERVAL_SECONDS=1

# 离线恢复解压硬限制
BACKUP_MAX_MEMBERS=10000
BACKUP_MAX_MEMBER_BYTES=536870912
BACKUP_MAX_TOTAL_BYTES=4294967296
BACKUP_MAX_COMPRESSION_RATIO=200

# Streamlit HTTP 客户端
API_BASE_URL="http://localhost:8000"
API_TIMEOUT_SECONDS=3
API_STREAM_TIMEOUT_SECONDS=120
