# 应用
APP_NAME="Local RAG Chat"
APP_VERSION="0.1.0"
DEBUG=false
API_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000

# 日志与本地数据（相对路径从项目根目录解析）
LOG_LEVEL="INFO"
LOG_DIR="logs"
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
CHROMA_DIR="data/chroma"
METADATA_DIR="data/metadata"
CHAT_HISTORY_DIR="data/chat_history"
# 默认不覆盖 DATABASE_URL，由程序根据项目根目录生成。自定义示例：
# DATABASE_URL="sqlite:///./data/metadata/local_rag_chat.db"

# 后续 RAG 阶段使用；初始化版本不会加载这些模型
EMBEDDING_MODEL="BAAI/bge-small-zh-v1.5"
CHAT_MODEL="not-configured"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.5

# 上传配置。列表必须使用 JSON 数组格式。
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS='[".txt", ".pdf", ".csv", ".json"]'

# Streamlit HTTP 客户端
API_BASE_URL="http://localhost:8000"
API_TIMEOUT_SECONDS=3
