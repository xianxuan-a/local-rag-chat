# 应用
APP_NAME="Local RAG Chat"
APP_VERSION="0.1.0"
DEBUG=false
API_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000

# 日志与本地数据（相对路径从项目根目录解析）
LOG_LEVEL="INFO"
LOG_DIR="logs"
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
CHROMA_DIR="data/chroma"
METADATA_DIR="data/metadata"
CHAT_HISTORY_DIR="data/chat_history"
# 默认不覆盖 DATABASE_URL，由程序根据项目根目录生成。自定义示例：
# DATABASE_URL="sqlite:///./data/metadata/local_rag_chat.db"

# 文件入库与检索配置。修改向量空间字段后必须执行整库重建。
EMBEDDING_PROVIDER="dashscope"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZATION="l2"
EMBEDDING_PROTOCOL_VERSION="dashscope-text-embedding-v1"
VECTOR_DISTANCE_METRIC="cosine"
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=10
CHAT_MODEL="qwen3-max"
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_ATTEMPTS=2
RAG_CONTEXT_MAX_CHARS=12000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=
REBUILD_HTTP_TIMEOUT_SECONDS=3600

# 上传配置。列表必须使用 JSON 数组格式。
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS='[".txt", ".pdf", ".csv", ".json"]'

# Streamlit HTTP 客户端
API_BASE_URL="http://localhost:8000"
API_TIMEOUT_SECONDS=3
API_STREAM_TIMEOUT_SECONDS=120
